# ============================================================================
# ORCA Marine Intelligence — Environment Variables Template
# ============================================================================
# Copy this file to .env.local and populate your credentials.
# Vite automatically exposes variables prefixed with VITE_ to the browser client.

# Google Maps JavaScript & Tile API Key
# Enable: Maps JavaScript API, Geocoding API, Places API in Google Cloud Console
# https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=
