# FloatChat / ORCA Environment Variables
# ======================================
# SINGLE source of truth: this is the ONLY env file the backend reads.
# Copy this file to `.env` (repo root) and fill in your values.
# `apps/api/app/config.py` resolves the repo-root `.env` by absolute path, so
# the app behaves identically no matter which directory you launch it from.
#
# Do NOT create apps/api/.env — it would be ignored.

# ---------------------------------------------------------------------------
# Database - PostgreSQL with PostGIS + pgvector (e.g. Supabase)
# Option 1: Full connection string (recommended)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/floatchat

# Option 2: Individual components (unused if DATABASE_URL is set)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=floatchat
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password

# Supabase (managed PostgreSQL/PostGIS)
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# ---------------------------------------------------------------------------
# LLM Provider - OpenRouter for free tier
LLM_PROVIDER=openrouter
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_TEMPERATURE=0.1

# Voice Providers
# STT - Sarvam AI (Indian languages)
STT_PROVIDER=sarvam
STT_API_KEY=your_sarvam_api_key_here

# TTS - ElevenLabs (high quality voices)
TTS_PROVIDER=elevenlabs
TTS_API_KEY=your_elevenlabs_api_key_here

# Translation - Google Cloud
TRANSLATION_PROVIDER=google
TRANSLATION_API_KEY=your_google_translation_api_key_here

# ---------------------------------------------------------------------------
# Data Sources
ARGO_GDAC_URL=https://data-argo.ifremer.fr/argo
ERDDAP_URL=https://erddap.ifremer.fr/erddap
ARGOVIS_URL=https://argovis.colorado.edu
# Legacy ARGO/Parquet cache location (CacheManager, ArgoClient)
CACHED_DATA_PATH=data/cached

# Real-time marine sources (INCOIS / IMD / MOSDAC) - legacy government feeds.
# These are kept DISABLED by default: IMD requires API key + IP whitelisting,
# MOSDAC's public geoserver is retired, and INCOIS tides are ARGO-only. The
# live stack uses Open-Meteo / CoastWatch / Storm Glass / OpenWeather / JTWC.
# Flip *_ENABLED=true only when an endpoint is genuinely reachable.
INCOIS_BASE_URL=https://incois.gov.in
INCOIS_API_KEY=
INCOIS_ENABLED=false
IMD_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=
IMD_ENABLED=false
MOSDAC_BASE_URL=https://mosdac.gov.in
MOSDAC_API_KEY=
MOSDAC_ENABLED=false

# Open-source scraping endpoints (used by adapters for HTML/ERDDAP/OGC data)
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in
INCOIS_LAS_URL=https://las.incois.gov.in
INCOIS_PFZ_URL=https://incois.gov.in/MarineFisheries/TextDataHome
INCOIS_RSMC_URL=https://incois.gov.in/oceanservices/rsmc.jsp
NHO_NAVAREA_URL=https://hydrobharat.gov.in/navarea-warnings
MOSDAC_GEOSERVER_URL=https://mosdac.gov.in/geoserver/wms
IMD_PUBLIC_API_URL=https://api.imd.gov.in/api/v1

# Open-Meteo keyless forecast APIs - primary real-time weather/wave source.
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ENABLED=true

# NOAA CoastWatch ERDDAP - keyless near-real-time satellite products.
# Fills the MOSDAC satellite role (retired geoserver) and feeds the
# derived satellite-SST-front PFZ fallback. No key needed.
COASTWATCH_ERDDAP_URL=https://coastwatch.pfeg.noaa.gov/erddap
COASTWATCH_MUR_SST_DATASET=jplMURSST41
COASTWATCH_CHL_DATASET=nesdisVHNchlaDaily
COASTWATCH_ENABLED=true

# Storm Glass (keyed API) - global tide extremes. Free tier = 10 requests/day
# (non-commercial); the scheduler polls ~9-10 coastal anchors once a day and
# each request returns a multi-day extremes window.
STORMGLASS_BASE_URL=https://api.stormglass.io/v2
STORMGLASS_API_KEY=your_stormglass_api_key_here
STORMGLASS_ENABLED=true

# JTWC (keyless public cyclone warnings feed) - metoc.navy.mil RSS + bulletins.
JTWC_BASE_URL=https://www.metoc.navy.mil
JTWC_ENABLED=true

# GDACS (EU public framework feed) - keyless cyclone alerts with geometry.
GDACS_BASE_URL=https://www.gdacs.org
GDACS_ENABLED=true

# OpenWeatherMap (keyed API) - secondary fallback + real-time gap filling.
# Set the key to enable; leave empty -> NOT_CONFIGURED (no fabricated weather).
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data
OPENWEATHER_API_KEY=
OPENWEATHER_ENABLED=true
OPENWEATHER_UNITS=metric

# ---------------------------------------------------------------------------
# Data acquisition behaviour (bounded retry/backoff + timeouts)
DATA_TIMEOUT_SECONDS=30.0
DATA_RETRY_LIMIT=3
DATA_RETRY_BACKOFF_SECONDS=2.0
DATA_POLL_INTERVAL_SECONDS=900
SOURCE_POLL_INTERVAL_SECONDS={"stormglass": 86400, "coastwatch": 21600, "openmeteo": 3600, "openweather": 10800, "jtwc": 10800, "gdacs": 10800}

# Minimal polling scheduler
SCHEDULER_ENABLED=true
SCHEDULER_IDLE_WAIT_SECONDS=60

# Freshness thresholds (seconds) - data older than the threshold is STALE.
OCEAN_FRESHNESS_SECONDS=21600
WEATHER_FRESHNESS_SECONDS=10800
WAVE_FRESHNESS_SECONDS=21600
TIDE_FRESHNESS_SECONDS=86400
PFZ_FRESHNESS_SECONDS=86400
WARNING_FRESHNESS_SECONDS=10800

# Physical plausibility bounds for validation
SST_MIN_C=-2.5
SST_MAX_C=45.0
WAVE_MAX_M=20.0
WIND_MAX_MS=70.0
CURRENT_MAX_MS=5.0

# Embeddings (hybrid RAG) - leave empty -> retrieval is FTS-only (no fake vectors).
EMBEDDINGS_API_KEY=
EMBEDDINGS_ENDPOINT=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Server
HOST=0.0.0.0
PORT=8000
MAX_AUDIO_SIZE_MB=10
RATE_LIMIT_RPM=60
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# ML persistence (relative to repo root when running from the API package)
ML_LEDGER_PATH=data/ml/ledger.json
ML_FEATURE_STORE_PATH=data/ml/feature_store.json